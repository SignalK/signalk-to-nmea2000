{
  "name": "signalk-to-nmea2000",
  "version": "3.0.0-beta.1",
  "description": "Signal K server plugin to convert Signal K to NMEA2000",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b --pretty false",
    "prepare": "npm run build",
    "test": "npm run build && mocha",
    "prettier": "prettier --write .",
    "ci-format": "prettier --check .",
    "create-release": "github-create-release --owner signalk --repository signalk-to-nmea2000",
    "release": "git tag -d v$npm_package_version ; git tag v$npm_package_version && git push --tags && git push && npm run create-release"
  },
  "keywords": [
    "signalk-node-server-plugin"
  ],
  "author": {
    "name": "Scott Bender",
    "email": "scott@scottbender.net"
  },
  "contributors": [
    {
      "name": "Teppo Kurki"
    }
  ],
  "license": "ISC",
  "dependencies": {
    "@canboat/canboatjs": "^4.0.0-beta.1",
    "@canboat/ts-pgns": "^3.1.0",
    "geolib": "^4.0.1",
    "lodash": "^4.17.4"
  },
  "peerDependencies": {
    "baconjs": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SignalK/signalk-to-nmea2000"
  },
  "devDependencies": {
    "@signalk/github-create-release": "^1.2.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/chai": "^4.3.20",
    "@types/lodash": "^4.17.27",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^4.3.3",
    "baconjs": "^3.0.0",
    "chai": "^4.1.2",
    "chai-json-equal": "^0.0.1",
    "mocha": "^11.8.0",
    "prettier": "^3.9.10",
    "signalk-server": "^2.35.1",
    "sinon": "^4.1.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
